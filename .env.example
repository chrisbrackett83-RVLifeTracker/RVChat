# --- LLM (at least one required for live answers) ---
# Prefer Gemini free tier; OpenAI is the fallback when Gemini is overloaded.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# Optional model overrides (on Gemini 503 the app also tries other flash models)
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-4o-mini

# --- Web search (at least one provider key for live search) ---
# Set SEARCH_PROVIDER to: tavily | serper | bing | brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# Or provider-specific aliases (used if SEARCH_API_KEY is empty):
# TAVILY_API_KEY=
# SERPER_API_KEY=
# BING_API_KEY=
# BRAVE_API_KEY=

# Cap search hits sent to the LLM (default 5, max 8)
# SEARCH_RESULT_LIMIT=5

# Force demo mode even when keys exist (UI testing)
# DEMO_MODE=true
